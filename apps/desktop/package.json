{
  "name": "continuum-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for a shared cloud project workspace",
  "main": "main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "dist:win": "npm run prepare:assets && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.continuum.desktop",
    "productName": "CONTINUUM",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "renderer/**/*", "LICENSE", "package.json"],
    "win": {
      "target": ["nsis"],
      "artifactName": "CONTINUUM-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CONTINUUM"
    }
  }
}
