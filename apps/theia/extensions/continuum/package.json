{
  "name": "@continuum/ide-extension",
  "version": "1.0.0",
  "private": true,
  "description": "CONTINUUM-specific commands and authenticated cloud panel for Eclipse Theia",
  "license": "UNLICENSED",
  "main": "lib/browser/continuum-frontend-module.js",
  "theiaExtensions": [
    {
      "frontend": "lib/browser/continuum-frontend-module"
    }
  ],
  "dependencies": {
    "@theia/core": "1.76.0",
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmitOnError false || true",
    "compile": "tsc -p tsconfig.json --noEmitOnError false || true",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  }
