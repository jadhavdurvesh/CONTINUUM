# Copy to .env locally. Never commit real values.
APP_ENV=development
APP_NAME=Continuum
LOG_LEVEL=INFO

# Supabase (populate locally)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing RELAY service (optional during initial phases)
RELAY_BASE_URL=
RELAY_API_KEY=

# Worker safety limits
MAX_CONCURRENT_TASKS=1
TASK_TIMEOUT_SECONDS=1800
MAX_TASK_RETRIES=2
